<div class="layout-grid">
  <slot name="left" />
  <slot name="right" />
</div>

<style>
  .layout-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 2fr) minmax(0, 5fr);
    width: 100%;
  }

  @media screen and (max-width: 1024px) {
    .layout-grid {
      grid-template-columns: 1fr;
    }
  }
</style>